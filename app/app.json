{
  "expo": {
    "name": "Mapesca",
    "slug": "mapesca",
    "scheme": "mapesca",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.mapesca.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Mapesca muestra tu ubicación en el mapa para que veas qué zonas te quedan cerca. / Mapesca shows your location on the map so you can see which zones are near you.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.mapesca.app",
      "adaptiveIcon": {
        "backgroundColor": "#061E3C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mapesca muestra tu ubicación en el mapa para que veas qué zonas te quedan cerca. / Mapesca shows your location on the map so you can see which zones are near you."
        }
      ],
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#061E3C"
        }
      ]
    ],
    "extra": {
      "dataUrl": "https://data.mapesca.org/v1",
      "eas": {
        "projectId": "cb2c9322-0c97-4b6f-8738-f84fe674b6b1"
      }
    },
    "owner": "topanglers",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cb2c9322-0c97-4b6f-8738-f84fe674b6b1",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "backgroundColor": "#061E3C",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
